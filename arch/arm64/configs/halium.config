# halium.config — Ubuntu Touch kernel requirements
# Applied on top of a70q_defconfig via deviceinfo_kernel_defconfig

# AppArmor security (required by UT)
CONFIG_SECURITY_APPARMOR=y
CONFIG_AUDIT=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1

# Console/VT (required for UT rootfs boot)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Device management
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# tmpfs ACL (required for UT)
CONFIG_TMPFS_POSIX_ACL=y

# cgroup device controller
CONFIG_CGROUP_DEVICE=y

# Required for LXC container
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y

# Required for systemd
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# Overlay filesystem for rootfs
CONFIG_OVERLAY_FS=y

# Disable module signing (not needed for UT dev builds)
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=n

# Disable Samsung security features (require Samsung hypervisor,
# not available on UT, and cause clang 17 assembly errors)
CONFIG_RKP_KDP=n
CONFIG_RKP_NS_PROT=n
CONFIG_RKP_DMAP_PROT=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_FIVE_TEE_DRIVER=n
CONFIG_FIVE_USE_QSEE=n
